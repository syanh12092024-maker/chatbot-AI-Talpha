{
  "name": "messenger-ai-closer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI chat closer cho Facebook Messenger (thị trường ME / COD) — Claude + n8n-style orchestration",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "web": "node src/web.js",
    "chat": "node src/local-chat.js",
    "subscribe": "node src/subscribe-pages.js",
    "pages": "node -e \"import('./src/pages.js').then(async m=>{const n=await m.loadPageTokens();console.log('Tổng page:',n);for(const [id,v] of m.getStore())console.log(' -',id,v.name)})\"",
    "report": "node src/report-cli.js",
    "wa:login": "node src/wa-login.js",
    "fix-labels": "node src/fix-tier-labels.js",
    "fix-dup": "node src/fix-dup-products.js",
    "tpl-approve": "node src/approve-templates.js",
    "migrate": "node db/migrate.js",
    "di-tru": "node db/di-tru/index.js",
    "test": "node --env-file-if-exists=.env --experimental-test-module-mocks --test 'test/*.test.*' 'v3/test/b/*.test.mjs'",
    "worker-v3": "node --env-file=.env src/queue/chay-worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "xlsx": "^0.18.5"
  }
}
